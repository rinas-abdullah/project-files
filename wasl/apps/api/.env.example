# API service configuration. Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wasl
# Base URL of the Python intelligence service (OR-Tools / SimPy / scikit-learn)
INTELLIGENCE_URL=http://localhost:8000
# Public URL of the web app (used to build QR handover links)
APP_PUBLIC_URL=http://localhost:3000
# Set to "true" only for the dedicated demo deployment. Enables /api/demo/reset for the demo organisation only.
DEMO_MODE=true
# Password used for seeded demo accounts. Change for any shared deployment.
DEMO_PASSWORD=
# Cookie security: set true behind HTTPS
COOKIE_SECURE=false
LOG_LEVEL=info
