# MongoDB connection string (local mongod or Atlas).
# Set to the literal value "memory" to run without any MongoDB installed —
# an in-process store is used instead (auto-seeded with the built-in labs on
# boot). Nothing persists across restarts; use a real MongoDB for anything
# beyond a quick local trial.
MONGODB_URI=mongodb://127.0.0.1:27017/risaq

# Secret used to sign session JWTs — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on
PORT=5000

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
