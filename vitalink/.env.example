# ── Required ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://vitalink:vitalink@localhost:5432/vitalink?schema=public"
# Auth.js session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
# Key for AES-256-GCM field encryption of National ID / phone (any long random string)
DATA_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# ── Demo ─────────────────────────────────────────────────
# Password for all seeded demo accounts
DEMO_PASSWORD="VitaLink@2026"
# Show the demo-accounts panel on the login page (set to false in any non-demo deployment)
DEMO_MODE=true

# ── Optional tuning ──────────────────────────────────────
# MEDIA_DIR=./storage/media          # where uploaded images/videos are stored (outside /public)
# SIM_TICK_MS=2000                   # simulation engine tick
# ACK_TIMEOUT_MIN=3                  # "No hospital acknowledgment" alert threshold
# HANDOVER_LIMIT_MIN=20              # "Long handover time" alert threshold
# VITALINK_DISABLE_SIM=1             # disable the in-process simulation/ops loop

# ── Live integrations (not provided — adapters refuse to run without them) ──
# NAFATH_API_URL= / NAFATH_CLIENT_ID= / NAFATH_CLIENT_SECRET=
# NPHIES_API_URL= / NPHIES_CLIENT_ID=
# HIS_HL7_ENDPOINT=
# EPCR_API_URL=
# MONITOR_GATEWAY_URL=
# ROUTING_OSRM_URL=https://your-osrm-host   # enables the OSRM route provider when ROUTING is set to SANDBOX/CONNECTED

# Data retention (days after a case is closed) — set per the operating authority's data agreement
RETENTION_MEDIA_DAYS=30
RETENTION_IDENTIFIER_DAYS=30
RETENTION_AUDIT_DAYS=365
# Hospital resource statuses older than this are treated as UNKNOWN by the destination engine
RESOURCE_STALE_MINUTES=240
